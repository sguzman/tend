{
  description = "Tend — native task management, packaged crate-by-crate with crate2nix";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    crate2nix.url = "github:nix-community/crate2nix/0.15.0";
    rust-overlay.url = "github:oxalica/rust-overlay";
    rust-overlay.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = { self, nixpkgs, crate2nix, rust-overlay, ... }:
    let
      # Scope the initial package to the actual target machine. Other platforms
      # remain on upstream Cargo CI until tested with Nix.
      system = "x86_64-linux";
      pkgs = import nixpkgs {
        inherit system;
        overlays = [ rust-overlay.overlays.default ];
      };
      lib = pkgs.lib;
      rustToolchain = pkgs.rust-bin.stable.latest.default;

      # GPUI loads Vulkan/GL and several system libraries dynamically.
      # Native crate overrides give the build scripts headers and pkg-config
      # data; the launcher provides the required shared libraries at runtime.
      gpuiLibraries = with pkgs; [
        wayland
        libxkbcommon
        vulkan-loader
        fontconfig
        freetype
        libglvnd
        xorg.libX11
        xorg.libxcb
        xorg.libXcursor
        xorg.libXrandr
        xorg.libXi
        xorg.libXext
      ];
      nativeBuildInputs = with pkgs; [
        pkg-config
        wayland-protocols
      ];

      withNativeLibraries = _attrs: {
        inherit nativeBuildInputs;
        buildInputs = gpuiLibraries;
      };

      # crate2nix invokes this for each crate. It does NOT call cargo build
      # for the entire workspace or use Crane.
      buildRustCrateForPkgs = p: p.buildRustCrate.override {
        rustc = rustToolchain;
        cargo = rustToolchain;
        defaultCrateOverrides = p.defaultCrateOverrides // {
          gpui = withNativeLibraries;
          gpui_platform = withNativeLibraries;
          fern_desktop = withNativeLibraries;
          # The font-kit/GPUI transitive dependency invokes pkg-config from
          # its own build.rs, before the desktop crate's overrides apply.
          "yeslogic-fontconfig-sys" = _attrs: {
            nativeBuildInputs = [ p.pkg-config ];
            buildInputs = [ p.fontconfig ];
          };
          # crate2nix isolates each path crate. RustEmbed's upstream
          # ../../assets path no longer resolves from that isolated root.
          # Give the assets crate its own copy during the Nix build only;
          # the upstream Cargo source layout remains unchanged.
          assets = _attrs: {
            postPatch = ''
              mkdir -p assets
              cp -R ${./assets}/. assets/
              substituteInPlace src/assets.rs --replace-fail '#[folder = "../../assets"]' '#[folder = "assets"]'
            '';
          };
        };
      };

      # Cargo.nix is generated by crate2nix from Cargo.lock, then committed.
      # Avoid IFD: vendoring Zed's nested Git workspaces loses inherited
      # workspace package metadata. The generated graph still builds per-crate.
      cargoNix = import ./Cargo.nix {
        inherit pkgs buildRustCrateForPkgs;
      };
      desktop = cargoNix.workspaceMembers.fern_desktop.build;

      tend = pkgs.runCommand "tend-0.1.11" {
        nativeBuildInputs = [ pkgs.makeWrapper ];
      } ''
        mkdir -p "$out/bin" "$out/share/applications" "$out/share/icons/hicolor/scalable/apps"

        # Binary is still called fern internally until the crate-renaming work.
        # Tend's wrapper isolates data and opts out of the upstream auto-updater.
        #
        # On the target non-NixOS Arch host, the Vulkan ICD JSON refers to
        # libGLX_nvidia.so.0 by soname. The Nix Vulkan loader cannot find the
        # host's driver in /usr/lib without adding that runtime directory.
        # This does not bundle or pin a GPU driver in the Nix store.
        # A future Home Manager targets.genericLinux.gpu wrapper can replace
        # this Arch-specific compatibility path.
        makeWrapper "${desktop}/bin/fern" "$out/bin/tend" \
          --set TEND_NIX_MANAGED 1 \
          --prefix LD_LIBRARY_PATH : "${lib.makeLibraryPath gpuiLibraries}:/usr/lib"

        install -m644 ${./assets/icon/tend.svg} "$out/share/icons/hicolor/scalable/apps/tend.svg"
        install -m644 ${./assets/linux/tend.desktop} "$out/share/applications/tend.desktop"
      '';
    in
    {
      packages.${system} = {
        inherit tend;
        default = tend;
      };

      apps.${system} = {
        default = {
          type = "app";
          program = "${tend}/bin/tend";
        };
        tend = {
          type = "app";
          program = "${tend}/bin/tend";
        };
      };

      checks.${system}.tend-build = tend;

      devShells.${system}.default = pkgs.mkShell {
        packages = [
          rustToolchain
          pkgs.pkg-config
          crate2nix.packages.${system}.default
          pkgs.nix-output-monitor
        ] ++ gpuiLibraries ++ [ pkgs.wayland-protocols ];
      };
    };
}
